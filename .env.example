# demo = deterministic state machine, NOT LLM autonomy. openai/groq = live model tool selection.
WORKER_MODE=demo
OPENAI_API_KEY=
# Select a Responses API model with function calling available to your account.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional free-tier hosted provider. See .env.groq.example and docs/FREE_LLM.md.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
WORKER_DB=data/worker.sqlite3
# Local sandbox credentials. Replace before sharing. Never give reviewer token to the model.
WORKER_API_TOKEN=local-worker
REVIEWER_TOKEN=local-reviewer
APPROVAL_THRESHOLD_MINOR=500000
MAX_STEPS=24
MAX_TOOL_ATTEMPTS=3
ENABLE_FAULTS=false
