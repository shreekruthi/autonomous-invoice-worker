# Groq Free tier: hosted real LLM tool calling, subject to your account's free quotas.
# No OpenAI API key or OpenAI credit is required in this mode.
WORKER_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
WORKER_DB=data/groq-live-01.sqlite3
WORKER_API_TOKEN=local-worker
REVIEWER_TOKEN=local-reviewer
APPROVAL_THRESHOLD_MINOR=500000
MAX_STEPS=24
MAX_TOOL_ATTEMPTS=3
ENABLE_FAULTS=true
